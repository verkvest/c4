{
  "name": "@kenrick95/c4-root",
  "version": "0.0.0",
  "description": "Aureline, an offline four-in-a-line game",
  "private": true,
  "workspaces": [
    "core",
    "browser",
    "server"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/kenrick95/c4.git"
  },
  "author": {
    "name": "Kenrick",
    "email": "kenrick95@gmail.com",
    "url": "https://kenrick95.org"
  },
  "bugs": {
    "url": "https://github.com/kenrick95/c4/issues"
  },
  "engines": {
    "node": "24.x",
    "yarn": "4.x"
  },
  "packageManager": "yarn@4.14.1",
  "homepage": "https://github.com/kenrick95/c4",
  "license": "MIT",
  "keywords": [
    "c4",
    "four-in-a-line",
    "game"
  ],
  "files": [
    "src/",
    "dist/"
  ],
  "scripts": {
    "dev": "concurrently --handle-input \"yarn:dev-server\" \"yarn:dev-browser\"",
    "dev-browser": "yarn workspace @kenrick95/c4-browser dev",
    "dev-server": "yarn workspace @kenrick95/c4-server dev",
    "lint": "biome check .",
    "lint:ci": "biome ci .",
    "lint:fix": "biome check --write .",
    "build:web": "yarn workspace @kenrick95/c4-browser build",
    "build:mobile": "yarn build:web && cap sync",
    "screenshots": "yarn workspace @kenrick95/c4-browser exec playwright test tests/phone-screenshots.spec.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.14",
    "@capacitor/assets": "3.0.5",
    "@capacitor/cli": "8.5.3",
    "concurrently": "9.2.1"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.5.3",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/ios": "8.5.3",
    "@capacitor/splash-screen": "8.0.2",
    "@capacitor/status-bar": "8.0.4"
  }
}
